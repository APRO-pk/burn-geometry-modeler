node_modules/
build/
dist/
coverage/

# Rust build artifacts (crates/burn-core and src-tauri). The generated wasm-pack
# output in crates/burn-core/pkg-* IS committed, so the JS build and tests work
# without a Rust toolchain installed.
target/

# Tauri desktop shell: compiled binaries/installers and generated schemas.
# The hand-written config (src-tauri/*.json, Cargo.toml, src/, icons/) IS
# committed; only these regenerable artifacts are ignored.
src-tauri/gen/
src-tauri/target/
.DS_Store
*.log
.env*

# Surrogate training data: regenerable from the seed with `npm run surrogate:sample`.
# The trained model (src/surrogate/model.json) IS committed -- the app needs it.
tools/data/*
# ...except the certified-motor fixture, which src/validation.test.ts needs to
# run offline and deterministically. It is real measured data, not generated.
!tools/data/thrustcurve-motors.json
!tools/data/nakka-strand-burner.json

# Claude Code: launch.json is shared project config (dev server for previews);
# settings.local.json is per-machine (permission allowlists, absolute paths).
.claude/settings.local.json

# Copied in by scripts/build-wasm.sh so wasm-pack stops warning; the real one
# is at the repository root.
crates/burn-core/LICENSE
